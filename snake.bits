00011001 00000000 00000000 00000000 01001000 00000000 00000000 00000000
01011111 01011111 01001100 01001001 01001110 01001011 01000101 01000100  ; "__LINKEDIT"
01001001 01010100 00000000 00000000 00000000 00000000 00000000 00000000
00000000 01000000 00000000 00000000 00000001 00000000 00000000 00000000  ; vmaddr 0x100004000
