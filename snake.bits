01011111 01011111 01010000 01000001 01000111 01000101 01011010 01000101  ; "__PAGEZERO"
01010010 01001111 00000000 00000000 00000000 00000000 00000000 00000000
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; vmaddr 0
00000000 00000000 00000000 00000000 00000001 00000000 00000000 00000000  ; vmsize 0x100000000
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; fileoff
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; filesize
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; maxprot, initprot (none)
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; nsects, flags

