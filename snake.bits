00011001 00000000 00000000 00000000 10011000 00000000 00000000 00000000
01011111 01011111 01010100 01000101 01011000 01010100 00000000 00000000  ; "__TEXT"
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000
00000000 00000000 00000000 00000000 00000001 00000000 00000000 00000000  ; vmaddr 0x100000000
00000000 01000000 00000000 00000000 00000000 00000000 00000000 00000000  ; vmsize 0x4000
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; fileoff 0
00000000 01000000 00000000 00000000 00000000 00000000 00000000 00000000  ; filesize 0x4000
00000101 00000000 00000000 00000000 00000101 00000000 00000000 00000000  ; maxprot, initprot r-x
00000001 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; nsects 1, flags
; section __text
01011111 01011111 01110100 01100101 01111000 01110100 00000000 00000000  ; "__text"
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000
01011111 01011111 01010100 01000101 01011000 01010100 00000000 00000000  ; "__TEXT"
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000
00000000 00000100 00000000 00000000 00000001 00000000 00000000 00000000  ; addr 0x100000400
01101100 00000011 00000000 00000000 00000000 00000000 00000000 00000000  ; size 0x36c (code only)
00000000 00000100 00000000 00000000  ; offset 0x400
00000010 00000000 00000000 00000000  ; align 2^2
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; reloff, nreloc
00000000 00000100 00000000 10000000  ; flags PURE_INSTRUCTIONS|SOME_INSTRUCTIONS
00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000  ; reserved1-3
00000000 00000000 00000000 00000000

